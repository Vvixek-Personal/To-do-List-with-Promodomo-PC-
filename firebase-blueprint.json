{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "streakDays": { "type": "number" },
        "totalPomodoros": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Todo Pomodoro task belonging to a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "estimatedPomodoros": { "type": "number" },
        "completedPomodoros": { "type": "number" },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "estimatedPomodoros", "completedPomodoros", "completed"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles keyed by Firebase Auth UID"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Subcollection of tasks owned by the specific user"
    }
  }
}
